#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "ScreenReflection"
    {
        token outputs:mtlx:surface.connect = </Root/ScreenReflection/Surface.outputs:out>

        def Shader "Video"
        {
            uniform token info:id = "ND_videoreflectiontexture_color4"
            string inputs:VideoId = "auraCinema"
            int inputs:VideoMode = 1
            color4f outputs:out
        }
        def Shader "Rgb"
        {
            uniform token info:id = "ND_convert_color4_color3"
            color4f inputs:in.connect = </Root/ScreenReflection/Video.outputs:out>
            color3f outputs:out
        }
        def Shader "Attenuation"
        {
            uniform token info:id = "ND_multiply_color3FA"
            color3f inputs:in1.connect = </Root/ScreenReflection/Rgb.outputs:out>
            float inputs:in2 = 0.09
            color3f outputs:out
        }
        def Shader "Surface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor = (0, 0, 0)
            color3f inputs:emissiveColor.connect = </Root/ScreenReflection/Attenuation.outputs:out>
            float inputs:ior = 1
            float inputs:roughness = 1
            token outputs:out
        }
    }

    def Mesh "Bezel" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/ScreenReflection>
        point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0),
                            (-0.49, -0.48, 0), (0.49, -0.48, 0), (0.49, 0.48, 0), (-0.49, 0.48, 0)]
        int[] faceVertexCounts = [4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        texCoord2f[] primvars:st = [(0.06, 0.12), (0.94, 0.12), (0.94, 0.88), (0.06, 0.88),
                                   (0.06, 0.12), (0.94, 0.12), (0.94, 0.88), (0.06, 0.88)] (
            interpolation = "vertex"
        )
        uniform token subdivisionScheme = "none"
    }
}
