<!-- The desktop app's own words, on top of the headset's (app/src/main/res/values/strings.xml):
     what only a desktop has, and the headset's sentences that read wrong at a desk. Same keys,
     same format, same three languages. -->
<resources>
    <!-- The headset's wording, reworded for a computer -->
    <string name="library_subtitle">Una parete di locandine per la tua libreria</string>
    <string name="source_uri_hint_smb">Basta l’host, ad es. 192.168.1.100; accedi, poi fai clic su “Sfoglia condivisioni” per scegliere una cartella</string>
    <string name="sources_local_media">Su questo computer</string>
    <string name="sources_local_dirs">Cartelle di questo computer</string>
    <string name="sources_local_folder">Una cartella di questo computer</string>
    <string name="sources_local_folder_hint">La cartella Filmati, un disco esterno, ovunque tieni i film</string>
    <string name="sources_local_desc">I film in una cartella di questo computer</string>
    <string name="sources_not_scanned_hint">Fai clic su “Scansiona” per iniziare</string>
    <string name="set_stored_local">Cosa resta su questo computer</string>
    <string name="set_credentials_body">Indirizzi, nomi utente e password del tuo NAS, WebDAV o media server restano solo su questo computer — cifrati con una chiave nel portachiavi di sistema —, servono a raggiungere i tuoi server e non vengono mai caricati.</string>
    <string name="set_no_collect_body">Reality NAS Player non ha account e non contiene statistiche, tracciamento o pubblicità. I tuoi file, il loro elenco, ciò che hai guardato e salvato restano solo su questo computer, a meno che tu non attivi la sincronizzazione — e allora solo sul tuo NAS.</string>
    <string name="set_about_line">Reality NAS Player · una parete di locandine per la tua libreria</string>
    <string name="set_about_body">Reality NAS Player trasforma il groviglio di file video su questo computer e sul tuo NAS in una parete di locandine, e li riproduce — tutto ciò che mpv sa riprodurre, cioè quasi tutto. Libero e open source.</string>
    <string name="set_language_hint">La lingua in cui Reality NAS Player scarica titoli, trame e generi.</string>
    <string name="set_language_system">Come il sistema</string>
    <string name="det_unmatched">Non riconosciuto automaticamente — usa “Correggi abbinamento” per impostarlo a mano</string>
    <string name="smb_other_subnet_when">Per quando il NAS non è sulla sottorete di questo computer</string>
    <string name="lib_empty_favorites">Ancora nessun preferito. Usa il cuore nella pagina di un titolo, o fai clic destro sulla sua locandina.</string>
    <string name="vid_no_video_decoder">Impossibile decodificare il video di questo file (%1$s).\nAudio e sottotitoli continuano.</string>

