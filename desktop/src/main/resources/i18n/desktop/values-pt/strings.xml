    <!-- The headset's wording, reworded for a computer -->
    <string name="library_subtitle">Um mural de pôsteres para sua biblioteca</string>
    <string name="source_uri_hint_smb">Basta o servidor, ex.: 192.168.1.100; entre com sua conta e clique em “Explorar pastas” para escolher uma pasta</string>
    <string name="sources_local_media">Neste computador</string>
