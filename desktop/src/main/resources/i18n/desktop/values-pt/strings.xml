    <string name="d_set_sync">Sincronização</string>
    <string name="d_sync_intro">Mantenha sua posição em cada vídeo, o que você assistiu e seus favoritos iguais em todos os seus dispositivos: o Reality NAS Player neste computador, em outro, nos óculos PICO. Sem conta e sem servidor: tudo fica numa pequena pasta oculta no seu próprio NAS.</string>
    <string name="d_sync_enable">Sincronizar este computador</string>
    <string name="d_sync_enable_hint">Desativado até você ativar. Ao desativar, a pasta fica como está.</string>
    <string name="d_sync_location">Onde</string>
    <string name="d_sync_location_hint">Uma pasta oculta “.aura” na raiz desta pasta compartilhada. Todos os dispositivos devem escolher a mesma.</string>
    <string name="d_sync_location_hint_folder">Uma pasta oculta “.aura” dentro desta pasta. Todos os dispositivos devem escolher o mesmo lugar.</string>
    <string name="d_sync_choose_folder">Outra pasta…</string>
    <string name="d_sync_no_location">Primeiro adicione uma pasta compartilhada do NAS em Fontes, ou escolha qualquer pasta, como uma que outro programa de sincronização já leve entre seus computadores.</string>
