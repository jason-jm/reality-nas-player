    <string name="d_set_sync">同步</string>
    <string name="d_sync_intro">让你每台设备上的 Reality NAS Player——这台电脑、另一台电脑、PICO 头显——保持一样的播放进度、已看状态和收藏。不需要账号，也不经过任何服务器：同步信息只放在你自己 NAS 上的一个小小的隐藏文件夹里。</string>
    <string name="d_sync_enable">在这台电脑上同步</string>
    <string name="d_sync_enable_hint">默认关闭。关闭后，NAS 上的文件夹保持原样。</string>
    <string name="d_sync_location">同步位置</string>
    <string name="d_sync_location_hint">这个共享顶层的隐藏文件夹“.aura”。所有设备都要选择同一个。</string>
    <string name="d_sync_location_hint_folder">这个文件夹里的隐藏文件夹“.aura”。所有设备都要选择同一个位置。</string>
    <string name="d_sync_choose_folder">其他文件夹…</string>
    <string name="d_sync_no_location">请先在“媒体来源”里添加一个 NAS 共享；也可以选择任意文件夹，比如已经由其他同步软件在电脑之间同步的文件夹。</string>
    <string name="d_sync_device_name">这台电脑的名称</string>
