    <string name="set_credentials_body">Alamat, nama pengguna dan kata laluan untuk NAS, WebDAV atau pelayan media anda hanya berada pada komputer ini — disulitkan dengan kunci dalam rantai kunci sistem — digunakan untuk mencapai pelayan anda sendiri, dan tidak pernah dimuat naik.</string>
    <string name="set_no_collect_body">Reality NAS Player tiada akaun dan tidak membawa analitis, penjejakan atau iklan. Fail anda, senarainya, apa yang anda tonton dan apa yang anda simpan hanya berada pada komputer ini, melainkan anda menghidupkan segerak — dan itu pun hanya pada NAS anda sendiri.</string>
    <string name="set_about_line">Reality NAS Player · dinding poster untuk pustaka anda</string>
    <string name="set_about_body">Reality NAS Player menjadikan longgokan fail video pada komputer ini dan NAS anda sebagai dinding poster, dan memainkannya — apa sahaja yang boleh dimainkan mpv, iaitu hampir semuanya. Percuma dan sumber terbuka.</string>
    <string name="set_language_hint">Bahasa yang Reality NAS Player gunakan untuk mengambil tajuk, ringkasan dan genre.</string>
    <string name="set_language_system">Ikut sistem</string>
    <string name="det_unmatched">Tidak dikenali secara automatik — gunakan “Betulkan padanan” untuk menetapkannya secara manual</string>
