    <string name="d_sync_devices">Alte dispozitive</string>
    <string name="d_sync_devices_none">Niciun alt dispozitiv nu s-a sincronizat încă. Activați sincronizarea în Reality NAS Player pe celelalte dispozitive și alegeți aceeași partajare.</string>
    <string name="d_sync_seen">%1$s · activ ultima dată %2$s</string>
    <string name="d_sync_readonly">Această partajare este doar în citire pentru acest computer: primește progresul celorlalte dispozitive, dar nu îl poate scrie pe al său.</string>
