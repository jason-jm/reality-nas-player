    <string name="d_set_sync">Synkronisering</string>
    <string name="d_sync_intro">Hold din plads i hver video, hvad du har set, og dine favoritter ens på alle dine enheder – Reality NAS Player på denne computer, på en anden, på PICO-headsettet. Ingen konto og ingen server: det hele ligger i en lille skjult mappe på din egen NAS.</string>
    <string name="d_sync_enable">Synkroniser denne computer</string>
    <string name="d_sync_enable_hint">Fra, medmindre du slår den til. Slår du den fra, bliver mappen, som den er.</string>
    <string name="d_sync_location">Hvor</string>
    <string name="d_sync_location_hint">En skjult mappe ».aura« øverst i denne deling. Alle enheder bør vælge den samme.</string>
    <string name="d_sync_location_hint_folder">En skjult mappe ».aura« i denne mappe. Alle enheder bør vælge det samme sted.</string>
    <string name="d_sync_choose_folder">Anden mappe…</string>
    <string name="d_sync_no_location">Tilføj først en NAS-deling under Kilder – eller vælg en hvilken som helst mappe, f.eks. en, som et andet synkroniseringsprogram allerede fører mellem dine computere.</string>
    <string name="d_sync_device_name">Computerens navn</string>
    <string name="d_sync_device_name_hint">Sådan som dine andre enheder viser den.</string>
    <string name="d_sync_what">Hvad der deles</string>
    <string name="d_sync_what_body">Hvor du er i hver video, om du har set den, dine favoritter og de match, du har rettet i hånden – for filer på en netværksdeling. Aldrig videoerne og intet på denne computers egne diske.</string>
    <string name="d_sync_nas_note">Reality NAS Player læser og skriver kun mappen, når den åbner, når du vender tilbage til dens vindue, omkring afspilning, og når den lukker – aldrig på en timer, så en NAS, der går i dvale ved inaktivitet, bliver ved med at sove.</string>
