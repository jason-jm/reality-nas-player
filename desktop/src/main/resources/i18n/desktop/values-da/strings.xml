    <string name="set_stored_local">Det, der gemmes på denne computer</string>
    <string name="set_credentials_body">Adresser, brugernavne og adgangskoder til din NAS, WebDAV eller dine medieservere ligger kun på denne computer – krypteret med en nøgle i systemets nøglering – bruges til at nå dine egne servere og uploades aldrig.</string>
    <string name="set_no_collect_body">Reality NAS Player har ingen konti og indeholder ingen analyse, sporing eller reklamer. Dine filer, listen over dem, hvad du har set, og hvad du har gemt, ligger kun på denne computer, medmindre du slår synkronisering til – og så kun på din egen NAS.</string>
    <string name="set_about_line">Reality NAS Player · en plakatvæg til dit bibliotek</string>
    <string name="set_about_body">Reality NAS Player forvandler virvaret af videofiler på denne computer og din NAS til en plakatvæg og afspiller dem – alt, hvad mpv kan afspille, og det er næsten alt. Gratis og open source.</string>
    <string name="set_language_hint">Det sprog, Reality NAS Player henter titler, resuméer og genrer på.</string>
    <string name="set_language_system">Følg systemet</string>
    <string name="det_unmatched">Ikke genkendt automatisk – brug »Ret match« for at angive den i hånden</string>
