    <string name="library_subtitle">En plakatvæg til dit bibliotek</string>
    <string name="source_uri_hint_smb">Værten alene er nok, f.eks. 192.168.1.100; log ind, og klik derefter på »Gennemse delinger« for at vælge en mappe</string>
    <string name="sources_local_media">På denne computer</string>
    <string name="sources_local_dirs">Mapper på denne computer</string>
