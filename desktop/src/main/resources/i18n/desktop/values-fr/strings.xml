    <!-- The headset's wording, reworded for a computer -->
    <string name="library_subtitle">Un mur d’affiches pour votre bibliothèque</string>
    <string name="source_uri_hint_smb">L’hôte seul suffit, p. ex. 192.168.1.100 ; connectez-vous, puis cliquez sur « Parcourir les partages » pour choisir un dossier</string>
