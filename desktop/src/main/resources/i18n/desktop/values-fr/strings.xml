    <string name="set_stored_local">Ce qui est conservé sur cet ordinateur</string>
    <string name="set_credentials_body">Les adresses, noms d’utilisateur et mots de passe de votre NAS, WebDAV ou serveurs multimédias restent sur cet ordinateur uniquement — chiffrés avec une clé du trousseau du système —, servent à joindre vos propres serveurs et ne sont jamais envoyés.</string>
    <string name="set_no_collect_body">Reality NAS Player n’a pas de comptes et ne contient ni statistiques, ni suivi, ni publicité. Vos fichiers, leur liste, ce que vous avez regardé et enregistré restent sur cet ordinateur seulement, sauf si vous activez la synchro — et alors uniquement sur votre propre NAS.</string>
    <string name="set_about_line">Reality NAS Player · un mur d’affiches pour votre bibliothèque</string>
    <string name="set_about_body">Reality NAS Player transforme le fouillis de fichiers vidéo de cet ordinateur et de votre NAS en mur d’affiches, et les lit — tout ce que mpv sait lire, c’est-à-dire presque tout. Libre et open source.</string>
    <string name="set_language_hint">La langue dans laquelle Reality NAS Player récupère titres, résumés et genres.</string>
    <string name="set_language_system">Comme le système</string>
    <string name="det_unmatched">Non reconnu automatiquement — utilisez « Corriger l’association » pour le définir à la main</string>
