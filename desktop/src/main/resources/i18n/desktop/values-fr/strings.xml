    <string name="lib_empty_favorites">Pas encore de favoris. Utilisez le cœur sur la page d’un titre, ou faites un clic droit sur son affiche.</string>
    <string name="vid_no_video_decoder">La vidéo de ce fichier n’a pas pu être décodée (%1$s).\nL’audio et les sous-titres continuent.</string>

