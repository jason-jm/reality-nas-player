     what only a desktop has, and the headset's sentences that read wrong at a desk. Same keys,
     same format, same three languages. -->
<resources>
    <!-- The headset's wording, reworded for a computer -->
    <string name="library_subtitle">Un muro de pósteres para tu biblioteca</string>
    <string name="source_uri_hint_smb">Basta con el servidor, p. ej. 192.168.1.100; inicia sesión y haz clic en “Explorar carpetas” para elegir una carpeta</string>
    <string name="sources_local_media">En este equipo</string>
    <string name="sources_local_dirs">Carpetas de este equipo</string>
    <string name="sources_local_folder">Una carpeta de este equipo</string>
    <string name="sources_local_folder_hint">Películas, un disco externo, cualquier lugar donde guardes películas</string>
