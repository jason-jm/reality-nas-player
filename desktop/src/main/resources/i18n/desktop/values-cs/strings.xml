    <string name="d_sync_devices">Další zařízení</string>
    <string name="d_sync_devices_none">Žádné jiné zařízení se zatím nesynchronizovalo. Zapněte synchronizaci v aplikaci Reality NAS Player na ostatních zařízeních a zvolte stejnou sdílenou složku.</string>
    <string name="d_sync_seen">%1$s · naposledy aktivní %2$s</string>
    <string name="d_sync_readonly">Tato sdílená složka je pro tento počítač jen pro čtení: přijímá postup ostatních zařízení, ale vlastní zapsat nemůže.</string>
