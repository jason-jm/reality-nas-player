    <string name="d_set_sync">Synkronointi</string>
    <string name="d_sync_intro">Pidä katselukohtasi joka videossa, katsomasi ja suosikkisi samoina kaikilla laitteillasi – Reality NAS Player tällä tietokoneella, toisella ja PICO-laseilla. Ei tiliä eikä palvelinta: tiedot ovat pienessä piilotetussa kansiossa omalla NAS-laitteellasi.</string>
    <string name="d_sync_enable">Synkronoi tämä tietokone</string>
    <string name="d_sync_enable_hint">Pois, ellet ota sitä käyttöön. Kun poistat sen käytöstä, kansio jää ennalleen.</string>
    <string name="d_sync_location">Sijainti</string>
    <string name="d_sync_location_hint">Piilotettu ”.aura”-kansio tämän jaon juuressa. Kaikkien laitteiden kannattaa valita sama.</string>
    <string name="d_sync_location_hint_folder">Piilotettu ”.aura”-kansio tämän kansion sisällä. Kaikkien laitteiden kannattaa valita sama paikka.</string>
    <string name="d_sync_choose_folder">Muu kansio…</string>
    <string name="d_sync_no_location">Lisää ensin NAS-jako kohdassa Lähteet – tai valitse mikä tahansa kansio, esimerkiksi sellainen, jota toinen synkronointiohjelma jo pitää ajan tasalla tietokoneidesi välillä.</string>
    <string name="d_sync_device_name">Tämän tietokoneen nimi</string>
    <string name="d_sync_device_name_hint">Millä nimellä muut laitteesi näyttävät sen.</string>
    <string name="d_sync_what">Mitä jaetaan</string>
    <string name="d_sync_what_body">Missä kohdassa olet kussakin videossa, oletko katsonut sen, suosikkisi ja käsin korjaamasi osumat – verkkojaon tiedostoille. Ei koskaan videoita eikä mitään tämän tietokoneen omilta levyiltä.</string>
    <string name="d_sync_nas_note">Reality NAS Player lukee ja kirjoittaa kansiota vain avautuessaan, kun palaat sen ikkunaan, toiston yhteydessä ja sulkeutuessaan – ei koskaan ajastimella, joten käyttämättömänä nukkuva NAS saa jatkaa unta.</string>
