    <string name="d_set_sync">Synchronizacja</string>
    <string name="d_sync_intro">Miejsce w każdym filmie, to, co obejrzano, i ulubione — takie same na wszystkich urządzeniach: w aplikacji Reality NAS Player na tym komputerze, na innym i w goglach PICO. Bez konta i serwera: wszystko jest w małym ukrytym folderze na własnym NAS-ie.</string>
    <string name="d_sync_enable">Synchronizuj ten komputer</string>
    <string name="d_sync_enable_hint">Wyłączone, dopóki nie włączysz. Wyłączenie pozostawia folder bez zmian.</string>
    <string name="d_sync_location">Gdzie</string>
    <string name="d_sync_location_hint">Ukryty folder „.aura” na najwyższym poziomie tego udziału. Każde urządzenie powinno wybrać ten sam.</string>
    <string name="d_sync_location_hint_folder">Ukryty folder „.aura” wewnątrz tego folderu. Każde urządzenie powinno wybrać to samo miejsce.</string>
    <string name="d_sync_choose_folder">Inny folder…</string>
    <string name="d_sync_no_location">Najpierw dodaj udział NAS w sekcji Źródła — albo wybierz dowolny folder, np. taki, który inny program do synchronizacji już przenosi między komputerami.</string>
    <string name="d_sync_device_name">Nazwa tego komputera</string>
    <string name="d_sync_device_name_hint">Jak widzą go inne urządzenia.</string>
    <string name="d_sync_what">Co jest udostępniane</string>
    <string name="d_sync_what_body">Miejsce w każdym filmie, informacja, czy go obejrzano, ulubione i ręcznie poprawione dopasowania — dla plików w udziałach sieciowych. Nigdy same filmy i nic z dysków tego komputera.</string>
    <string name="d_sync_nas_note">Reality NAS Player czyta i zapisuje folder tylko przy uruchomieniu, przy powrocie do jej okna, wokół odtwarzania i przy zamykaniu — nigdy według zegara, więc NAS usypiany przy bezczynności dalej śpi.</string>
