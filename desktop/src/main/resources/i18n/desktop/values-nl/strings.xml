<!-- The desktop app's own words, on top of the headset's (app/src/main/res/values/strings.xml):
     what only a desktop has, and the headset's sentences that read wrong at a desk. Same keys,
     same format, same three languages. -->
<resources>
    <!-- The headset's wording, reworded for a computer -->
    <string name="library_subtitle">Een posterwand voor je bibliotheek</string>
    <string name="source_uri_hint_smb">Alleen de host is genoeg, bijv. 192.168.1.100; log in en klik dan op “Gedeelde mappen” om een map te kiezen</string>
    <string name="sources_local_media">Op deze computer</string>
