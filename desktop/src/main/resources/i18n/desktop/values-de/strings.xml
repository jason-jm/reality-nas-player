    <string name="library_subtitle">Eine Posterwand für deine Mediathek</string>
    <string name="source_uri_hint_smb">Der Host allein reicht, z. B. 192.168.1.100; melde dich an und klicke dann auf „Freigaben durchsuchen“, um einen Ordner zu wählen</string>
    <string name="sources_local_media">Auf diesem Computer</string>
