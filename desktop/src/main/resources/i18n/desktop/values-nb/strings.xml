    <string name="library_subtitle">En plakatvegg for biblioteket ditt</string>
    <string name="source_uri_hint_smb">Verten alene er nok, f.eks. 192.168.1.100; logg på og klikk på «Bla gjennom delinger» for å velge en mappe</string>
    <string name="sources_local_media">På denne datamaskinen</string>
