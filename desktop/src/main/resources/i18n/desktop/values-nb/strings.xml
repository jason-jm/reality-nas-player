    <string name="d_set_sync">Synk</string>
    <string name="d_sync_intro">Hold plassen din i hver video, hva du har sett og favorittene dine likt på alle enhetene dine – Reality NAS Player på denne datamaskinen, på en annen, på PICO-headsettet. Ingen konto og ingen server: alt ligger i en liten skjult mappe på din egen NAS.</string>
    <string name="d_sync_enable">Synk denne datamaskinen</string>
    <string name="d_sync_enable_hint">Av med mindre du slår det på. Slår du det av, blir mappen som den er.</string>
    <string name="d_sync_location">Hvor</string>
    <string name="d_sync_location_hint">En skjult «.aura»-mappe øverst i denne delingen. Alle enheter bør velge den samme.</string>
    <string name="d_sync_location_hint_folder">En skjult «.aura»-mappe inne i denne mappen. Alle enheter bør velge samme sted.</string>
    <string name="d_sync_choose_folder">Annen mappe…</string>
    <string name="d_sync_no_location">Legg til en NAS-deling under Kilder først – eller velg en hvilken som helst mappe, for eksempel en som et annet synkprogram allerede holder lik mellom datamaskinene dine.</string>
    <string name="d_sync_device_name">Navnet på denne datamaskinen</string>
    <string name="d_sync_device_name_hint">Slik viser de andre enhetene dine den.</string>
    <string name="d_sync_what">Hva som deles</string>
    <string name="d_sync_what_body">Hvor du er i hver video, om du har sett den, favorittene dine og treffene du har rettet for hånd – for filer på en nettverksdeling. Aldri videoene, og ingenting på denne datamaskinens egne disker.</string>
    <string name="d_sync_nas_note">Reality NAS Player leser og skriver mappen bare når den åpnes, når du går tilbake til vinduet, rundt avspilling og når den avsluttes – aldri på en tidtaker, så en NAS som sover når den er inaktiv, fortsetter å sove.</string>
