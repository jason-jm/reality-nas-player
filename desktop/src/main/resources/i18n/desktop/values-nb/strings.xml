    <string name="set_stored_local">Hva som lagres på denne datamaskinen</string>
    <string name="set_credentials_body">Adressene, brukernavnene og passordene til NAS, WebDAV eller medieservere ligger bare på denne datamaskinen – kryptert med en nøkkel i systemets nøkkelring – brukes til å nå dine egne servere og lastes aldri opp.</string>
    <string name="set_no_collect_body">Reality NAS Player har ingen kontoer og inneholder ingen analyse, sporing eller reklame. Filene dine, listen over dem, hva du har sett og hva du har lagret, ligger bare på denne datamaskinen, med mindre du slår på synk – og da bare på din egen NAS.</string>
    <string name="set_about_line">Reality NAS Player · en plakatvegg for biblioteket ditt</string>
    <string name="set_about_body">Reality NAS Player gjør virvaret av videofiler på denne datamaskinen og NAS-en din om til en plakatvegg og spiller dem av – alt mpv kan spille av, som er nesten alt. Gratis og åpen kildekode.</string>
    <string name="set_language_hint">Språket Reality NAS Player henter titler, sammendrag og sjangre på.</string>
    <string name="set_language_system">Følg systemet</string>
    <string name="det_unmatched">Ikke gjenkjent automatisk – bruk «Endre treff» for å angi den for hånd</string>
