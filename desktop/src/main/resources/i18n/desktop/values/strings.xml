    <string name="d_set_sync">Sync</string>
    <string name="d_sync_intro">Keep your place in each video, what you’ve watched and your favourites the same on all your devices — Reality NAS Player on this computer, on another, on the PICO headset. No account and no server: it lives in a small hidden folder on your own NAS.</string>
    <string name="d_sync_enable">Sync this computer</string>
    <string name="d_sync_enable_hint">Off unless you turn it on. Turning it off leaves the folder as it is.</string>
    <string name="d_sync_location">Where</string>
    <string name="d_sync_location_hint">A hidden “.aura” folder at the top of this share. Every device should choose the same one.</string>
    <string name="d_sync_location_hint_folder">A hidden “.aura” folder inside this folder. Every device should choose the same place.</string>
    <string name="d_sync_choose_folder">Other folder…</string>
    <string name="d_sync_no_location">Add a NAS share under Sources first — or choose any folder, such as one another sync program already carries between your computers.</string>
    <string name="d_sync_device_name">This computer’s name</string>
    <string name="d_sync_device_name_hint">How your other devices list it.</string>
    <string name="d_sync_what">What is shared</string>
    <string name="d_sync_what_body">Where you are in each video, whether you’ve watched it, your favourites, and the matches you corrected by hand — for files on a network share. Never the videos, and nothing on this computer’s own disks.</string>
    <string name="d_sync_nas_note">Reality NAS Player reads and writes the folder only when it opens, when you come back to its window, around playback and when it quits — never on a timer, so a NAS that sleeps when idle stays asleep.</string>
