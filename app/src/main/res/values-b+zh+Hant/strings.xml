    <string name="set_autoplay_on">開：一集播完（或播到片尾標記處）後，倒數 5 秒接著播下一集。</string>
    <string name="set_autoplay_off">關：播完停在原處，「接下來播放」的卡片等你決定。</string>
    <string name="set_cast">接收投屏</string>
    <string name="set_cast_on">開：同一 Wi-Fi 下的手機點「投屏」即可找到「%1$s」（B 站、騰訊影片、愛奇藝、BubbleUPnP 等），在頭顯上播放。</string>
    <string name="set_cast_off">關：頭顯不會出現在手機的投屏清單裡。</string>
    <string name="set_cast_name">Reality NAS Player · %1$s</string>
    <string name="set_night_on">開：壓低爆炸與配樂，提升對白；5.1 音軌的人聲聲道也會加強。</string>
    <string name="set_night_off">關：保持影片原本的動態。播放時也可在「音訊設定」裡開關。</string>
    <string name="set_enhanced_engine">增強播放引擎</string>
    <string name="set_engine_on">開：Media3/ExoPlayer——支援音軌切換、內嵌與外掛字幕、更完整的格式。</string>
    <string name="set_engine_off">關：系統內建播放器（備援）。切換後下次開啟影片生效。</string>
    <string name="set_spatial_audio">系統空間音訊</string>
    <string name="set_spatial_on_off">開：交給 PICO 空間音訊引擎處理。關：按影片原始混音播放。</string>
    <string name="set_spatial_note">本機上開啟時 4K + TrueHD 7.1 會偶發斷音，因此預設關閉。下一部影片生效。</string>
    <string name="set_experimental">實驗</string>
    <string name="set_fd_bridge">fd 橋接</string>
    <string name="set_fd_hint">關：本機 HTTP 代理（穩定）。開：原生檔案描述元，延遲更低，僅系統播放器支援。</string>
    <string name="set_play_trouble">播放卡頓、無聲或黑畫面時，這兩個開關值得各換一檔試試。</string>
    <string name="set_rebuild">重建刮削結果</string>
    <string name="set_danger">危險操作</string>
    <string name="set_clear_library">清空媒體庫</string>
    <string name="set_clear_hint">刪除全部刮削項目與封面快取，回到最初狀態</string>
    <string name="set_clear">清空</string>
    <string name="set_clear_note">來源設定會保留，清空後重新掃描即可重建。注意：手動「修正匹配」過的項目在普通重掃時不會被覆蓋，而清空是徹底重設，這些修正也會一併遺失。</string>
    <string name="set_clear_q">清空整個媒體庫？</string>
    <string name="set_clear_body">全部刮削項目、封面快取和手動修正過的匹配都會被刪除。來源設定保留，之後重新掃描可以重建。</string>
    <string name="set_privacy_sub">你的媒體資料屬於你</string>
    <string name="set_no_collect">我們不收集什麼</string>
    <string name="set_no_collect_body">Reality NAS Player 無須帳號，沒有廣告或使用統計。媒體庫儲存在頭戴裝置。開啟 NAS 同步後，播放進度、收藏和手動配對也會寫入你選擇的共享資料夾。</string>
    <string name="set_when_network">什麼時候連網</string>
    <string name="set_scrape_metadata">刮削中繼資料</string>
    <string name="set_scrape_metadata_body">掃描時把從檔名解析出的標題關鍵字（如 “Interstellar 2014”）傳給 TMDB / AniList / Bangumi / Jikan 等公開資料庫換取海報和簡介。不傳送完整路徑、伺服器位址、憑證或裝置識別碼。</string>
    <string name="set_you_asked">你主動觸發的下載</string>
    <string name="set_you_asked_body">下載到本機時，檔案只從你自己的伺服器複製到頭戴裝置；播放時影片資料也只在頭戴裝置與你自己的伺服器之間傳輸，不經過任何第三方。</string>
    <string name="set_offline_note">離線刮削使用本機規則辨識片名，略過線上中繼資料與封面查詢。你仍可播放 NAS 上的影片。</string>
    <string name="set_stored_local">儲存在本機的資料</string>
    <string name="set_credentials">來源憑證</string>
    <string name="set_credentials_body">NAS / WebDAV / Jellyfin 的位址、使用者名稱和密碼只存在頭戴裝置本機，僅用於連線你自己的伺服器，絕不上傳。</string>
    <string name="set_library_cache">媒體庫與快取</string>
    <string name="set_library_cache_body">辨識結果、海報快取、設定、收藏與觀看紀錄。可在「媒體庫」頁清空。</string>
    <string name="set_about_line">Reality NAS Player · 空間海報牆 · 智慧媒體庫</string>
    <string name="set_version">版本</string>
    <string name="set_about_body">Reality NAS Player 把本機和 NAS 上雜亂的影片檔案自動整理成海報牆，預設在共享空間裡播放 —— 螢幕釘在房間裡，不用把你關進黑盒子。</string>
    <string name="set_data_sources">資料來源</string>
    <string name="set_tmdb_notice">本產品使用 TMDB API，但未經 TMDB 認可或認證。This product uses the TMDB API but is not endorsed or certified by TMDB.</string>
    <string name="set_anime_dbs">AniList · Bangumi 番組計畫 · MyAnimeList (Jikan) · OMDb · IMDb Datasets</string>
    <string name="set_anime_dbs_body">動畫與評分資料來自這些社群資料庫，感謝它們的開放介面。</string>
    <string name="set_environments">虛擬環境</string>
    <string name="set_environments_note">四個觀影環境均為 Reality NAS Player 原創，使用了 Poly Haven 的 CC0 掃描素材。太空觀景廳窗外的地球使用下列 NASA 影像。</string>
    <string name="set_ffmpeg">音訊解碼使用 FFmpeg（LGPL v2.1+）的 libavcodec/libavutil/libswresample 元件。</string>
    <string name="set_ffmpeg_tm">FFmpeg 是 FFmpeg 專案的商標。建置與替換方式見隨應用發布的說明。</string>
    <string name="set_mpv">舊格式（RMVB、WMV、FLV、XviD 等）由 mpv（LGPL v2.1+）播放，並用到 FFmpeg（LGPL v2.1+）、libass（ISC）、libplacebo（LGPL v2.1+）、HarfBuzz（MIT）、FreeType（FreeType 授權）、FriBidi（LGPL v2.1+）、Fontconfig（MIT）、libunibreak（zlib）、libxml2（MIT）和 mpv-android 的 JNI 層（MIT）。建置與替換方式見隨應用發布的說明。</string>
    <string name="set_diagnostics">診斷</string>
    <string name="set_last_crash">上次異常結束</string>
    <string name="set_crash_where">紀錄檔儲存在本機 %1$s/ 目錄，回報問題時可以一併提供</string>
