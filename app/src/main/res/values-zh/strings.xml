    <string name="set_engine_off">关：系统内置播放器（兜底）。切换后下次打开视频生效。</string>
    <string name="set_spatial_audio">系统空间音频</string>
    <string name="set_spatial_on_off">开：交给 PICO 空间音频引擎处理。关：按影片原始混音播放。</string>
    <string name="set_spatial_note">本机上开启时 4K + TrueHD 7.1 会偶发断音，因此默认关闭。下一部影片生效。</string>
    <string name="set_experimental">实验</string>
    <string name="set_fd_bridge">fd 桥接</string>
    <string name="set_fd_hint">关：本地 HTTP 代理（稳定）。开：原生文件描述符，延迟更低，仅系统播放器支持。</string>
    <string name="set_play_trouble">播放卡顿、无声或黑屏时，这两个开关值得各换一档试试。</string>
    <string name="set_rebuild">重建刮削结果</string>
    <string name="set_danger">危险操作</string>
    <string name="set_clear_library">清空媒体库</string>
    <string name="set_clear_hint">删除全部刮削条目与封面缓存，回到最初状态</string>
    <string name="set_clear">清空</string>
    <string name="set_clear_note">来源配置会保留，清空后重新扫描即可重建。注意：手动「修正匹配」过的条目在普通重扫时不会被覆盖，而清空是彻底重置，这些修正也会一并丢失。</string>
    <string name="set_clear_q">清空整个媒体库？</string>
    <string name="set_clear_body">全部刮削条目、封面缓存和手动修正过的匹配都会被删除。来源配置保留，之后重新扫描可以重建。</string>
    <string name="set_privacy_sub">你的媒体数据属于你</string>
    <string name="set_no_collect">我们不收集什么</string>
    <string name="set_no_collect_body">Reality NAS Player 没有账号系统、广告或使用统计。片库保存在头显。开启 NAS 同步后，观看进度、收藏和手动匹配也会写入你选择的共享文件夹。</string>
    <string name="set_when_network">什么时候联网</string>
    <string name="set_scrape_metadata">刮削元数据</string>
    <string name="set_scrape_metadata_body">扫描时把从文件名解析出的标题关键词（如 “Interstellar 2014”）发给 every.film / NeoDB / Wikidata / OFDb / TMDB / AniList / Bangumi / Jikan 等公开数据库换取海报和简介。不发送完整路径、服务器地址、凭据或设备标识。</string>
    <string name="set_you_asked">你主动触发的下载</string>
    <string name="set_you_asked_body">下载到本机时，文件只从你自己的服务器复制到头显；播放时视频数据也只在头显与你自己的服务器之间传输，不经过任何第三方。</string>
    <string name="set_offline_note">离线刮削使用本地规则识别片名，跳过在线元数据和封面查询。你仍可播放 NAS 上的影片。</string>
    <string name="set_stored_local">保存在本地的数据</string>
    <string name="set_credentials">来源凭据</string>
    <string name="set_credentials_body">NAS / WebDAV / Jellyfin 的地址、用户名和密码只存在头显本地，仅用于连接你自己的服务器，绝不上传。</string>
    <string name="set_library_cache">媒体库与缓存</string>
    <string name="set_library_cache_body">识别结果、海报缓存、设置、收藏与观看历史。可在「媒体库」页清空。</string>
    <string name="set_about_line">Reality NAS Player · 空间海报墙 · 智能媒体库</string>
    <string name="set_version">版本</string>
    <string name="set_about_body">Reality NAS Player 把本地和 NAS 上杂乱的视频文件自动整理成海报墙，默认在共享空间里播放 —— 屏幕钉在房间里，不用把你关进黑盒子。</string>
    <string name="set_data_sources">数据来源</string>
    <string name="set_tmdb_notice">本产品使用 TMDB API，但未经 TMDB 认可或认证。This product uses the TMDB API but is not endorsed or certified by TMDB.</string>
    <string name="set_anime_dbs">AniList · Bangumi 番组计划 · MyAnimeList (Jikan) · OMDb · IMDb Datasets</string>
    <string name="set_anime_dbs_body">番剧与评分数据来自这些社区数据库，感谢它们的开放接口。</string>
    <string name="set_environments">虚拟环境</string>
    <string name="set_environments_note">四个观影环境均为 Reality NAS Player 原创，使用了 Poly Haven 的 CC0 扫描素材。太空观景厅窗外的地球使用下列 NASA 影像。</string>
    <string name="set_ffmpeg">音频解码使用 FFmpeg（LGPL v2.1+）的 libavcodec/libavutil/libswresample 组件。</string>
    <string name="set_ffmpeg_tm">FFmpeg 是 FFmpeg 项目的商标。构建与替换方式见随应用发布的说明。</string>
    <string name="set_mpv">旧格式（RMVB、WMV、FLV、XviD 等）由 mpv（LGPL v2.1+）播放，并用到 FFmpeg（LGPL v2.1+）、libass（ISC）、libplacebo（LGPL v2.1+）、HarfBuzz（MIT）、FreeType（FreeType 许可）、FriBidi（LGPL v2.1+）、Fontconfig（MIT）、libunibreak（zlib）、libxml2（MIT）和 mpv-android 的 JNI 层（MIT）。构建与替换方式见随应用发布的说明。</string>
    <string name="set_diagnostics">诊断</string>
    <string name="set_last_crash">上次异常退出</string>
    <string name="set_crash_where">日志保存在本机 %1$s/ 目录，反馈问题时可以一并提供</string>
    <string name="set_language">语言</string>
