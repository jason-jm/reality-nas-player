--- a/libavcodec/mediacodecdec.c
+++ b/libavcodec/mediacodecdec.c
@@ -32,6 +32,7 @@
 #include "libavutil/intreadwrite.h"
 #include "libavutil/pixfmt.h"
 #include "libavutil/internal.h"
+#include "libavutil/time.h"
 
 #include "avcodec.h"
 #include "codec_internal.h"
@@ -486,11 +487,18 @@
     return ret;
 }
 
+/* How long the codec may hold every input buffer and give no output before it is taken for stuck.
+ * A decoder fed from a point it cannot start at (a non-IDR frame after a seek into a Blu-ray stream,
+ * on some decoders) takes all its input and gives nothing back: without a limit the loop below spins
+ * forever, and the caller can neither play nor fall back to software decoding. */
+#define MAX_STALL_US 3000000
+
 static int mediacodec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
 {
     MediaCodecH264DecContext *s = avctx->priv_data;
     int ret;
     ssize_t index;
+    int64_t stalled_since = 0;
 
     /* In delay_flush mode, wait until the user has released or rendered
        all retained frames. */
@@ -519,8 +527,17 @@
                  * return EAGAIN, which violate the design.
                  */
                 if (ff_AMediaCodec_infoTryAgainLater(s->ctx->codec, index) &&
-                    ret == AVERROR(EAGAIN))
+                    ret == AVERROR(EAGAIN)) {
+                    int64_t now = av_gettime_relative();
+                    if (!stalled_since) {
+                        stalled_since = now;
+                    } else if (now - stalled_since > MAX_STALL_US) {
+                        av_log(avctx, AV_LOG_ERROR, "MediaCodec gave no output for %d s with its input full\n",
+                               MAX_STALL_US / 1000000);
+                        return AVERROR_EXTERNAL;
+                    }
                     continue;
+                }
                 return ret;
             }
             s->ctx->current_input_buffer = index;
